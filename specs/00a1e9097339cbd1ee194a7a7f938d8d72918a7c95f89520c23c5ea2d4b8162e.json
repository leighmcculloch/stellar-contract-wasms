  {
    "function_v0": {
      "doc": "Share balance. Read by `receipt-vault` through a SEP-41 `TokenClient`.\\n\\nRenews the holder's TTL on the way past. `Shares(owner)` is persistent\\nstate that is otherwise only bumped on write, so a market that holds a\\nposition without depositing or withdrawing for the entry lifetime would\\nsee its balance archived to zero while `total_shares` still counted it \\xe2\\x80\\x94\\nand could then never redeem. `receipt-vault` reads this on every\\nboosted-value refresh, so renewing here keeps live claims alive.",
      "name": "balance",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": "address"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Accepts underlying and mints shares.\\n\\nDeliberately does **not** call `from.require_auth()`: `receipt-vault`\\npre-authorizes only the inner token transfer (contract.rs:311-327), and\\nthat transfer's own auth requirement is what makes this safe \\xe2\\x80\\x94 a caller\\ncannot pull funds from an address that has not signed.",
      "name": "deposit",
      "inputs": [
        {
          "doc": "",
          "name": "amounts_desired",
          "type_": {
            "vec": {
              "element_type": "i128"
            }
          }
        },
        {
          "doc": "",
          "name": "amounts_min",
          "type_": {
            "vec": {
              "element_type": "i128"
            }
          }
        },
        {
          "doc": "",
          "name": "from",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "invest",
          "type_": "bool"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Permissionless: claim the configured primary reward, third-party gauge\\nincentives and accrued swap fees, convert everything to underlying,\\nand redeploy.\\n\\nRate-limited because each call moves the share price; without a cooldown\\nit could be used to grind rounding in the depositor's favour.",
      "name": "harvest",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
