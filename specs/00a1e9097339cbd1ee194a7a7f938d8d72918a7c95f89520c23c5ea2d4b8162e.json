    "function_v0": {
      "doc": "Permissionlessly recenters the vault's one active position.\\n\\nThe old position is withdrawn in full. A single guarded swap converts\\nonly the excess side into the exact token ratio quoted for the new\\nspacing-aligned range, avoiding a wasteful sell-and-buy round trip. The\\ncall reverts atomically unless a new position is minted and at least\\n95% of the pre-deposit pair value is put back to work.",
      "name": "rebalance",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        }
      ],
      "outputs": [
