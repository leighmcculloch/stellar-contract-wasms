  {
    "udt_struct_v0": {
      "doc": "Pool wiring and the currently active position range.\\n\\nEverything here lives in a single **instance** storage entry. That is not a\\nstyle preference: the market-deposit path spans ReceiptVault -> this vault\\n-> the Aquarius pool -> three token contracts, and Soroban caps a\\ntransaction at 100 footprint ledger entries. One entry per config field put\\nthe end-to-end deposit at 113 and made it unexecutable on-chain.",
      "lib": "",
      "name": "Config",
      "fields": [
        {
          "doc": "",
          "name": "dec0",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "dec1",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "oracle",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "pool",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "tick_lower",
          "type_": "i32"
        },
        {
          "doc": "",
          "name": "tick_upper",
          "type_": "i32"
        },
        {
          "doc": "",
          "name": "token0",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token1",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "underlying_index",
          "type_": "u32"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Admin-tunable risk parameters. Also a single instance entry.",
      "lib": "",
      "name": "Params",
      "fields": [
        {
          "doc": "",
          "name": "harvest_cooldown",
          "type_": "u64"
        },
        {
          "doc": "Cap on underlying deployed into the pool; 0 disables it.",
          "name": "max_deploy",
          "type_": "u128"
        },
        {
          "doc": "Maximum tolerated gap between the pool's own swap quote and the\\noracle-implied fair rate, in basis points. `0` disables the check.\\n\\nThe per-swap slippage floor is derived from `estimate_swap`, so it only\\nguards against movement between quote and execution \\xe2\\x80\\x94 it cannot tell\\nthat the pool itself is mispriced. Entering or exiting through a\\ndislocated pool can realize that gap immediately: on testnet a ~7%\\npool/oracle divergence cost 4.65% of a deposit. This guards both\\nposition entry and the paired-token leg of position exit.",
          "name": "max_pool_divergence_bps",
          "type_": "u32"
        },
        {
          "doc": "How long a cached NAV root stays usable without re-reading the oracle.\\n\\nThis is a footprint budget decision as much as a freshness one: the\\nReceiptVault withdraw path already spans six contracts, and pulling two\\nReflector prices inside it pushed the transaction over Soroban's\\n100-entry cap. The ratio being cached is between two pegged assets, so\\nit moves slowly; `refresh_nav_root()` forces an update out of band.",
          "name": "nav_root_max_age",
          "type_": "u64"
        },
        {
          "doc": "Hard ceiling on how old the cached NAV root may be when the oracle is\\nunreachable. Past this the vault refuses to price rather than serving an\\narbitrarily obsolete ratio. `0` disables the bound.",
          "name": "nav_root_max_stale",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "oracle_max_age_mult",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "paused",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "slippage_bps",
          "type_": "u32"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Keeper-managed range policy. Stored outside `Config` so an upgrade can\\ndecode the exact Config value already present on Mainnet.",
      "lib": "",
      "name": "RangeParams",
      "fields": [
        {
          "doc": "",
          "name": "enabled",
          "type_": "bool"
        },
        {
          "doc": "Requested distance from the center to either edge, in raw ticks.\\nBounds are rounded outward to the pool's tick spacing.",
          "name": "half_width_ticks",
          "type_": "u32"
        },
        {
          "doc": "Independent, tighter pool/oracle guard used only for recentering.",
          "name": "max_rebalance_divergence_bps",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "rebalance_cooldown",
          "type_": "u64"
        },
        {
          "doc": "Recenter when spot enters this many ticks of either edge.",
          "name": "rebalance_margin_ticks",
          "type_": "u32"
        }
      ]
    }
  },
  {
    "udt_struct_v0": {
      "doc": "Last observed token amounts backing the active concentrated position.\\n\\nUnlike a full-range position, concentrated-liquidity NAV cannot be derived\\nfrom liquidity alone: its token mix changes as pool price moves through the\\nconfigured range. The keeper refreshes this snapshot from Aquarius and all\\nposition mutations update it from actual token balance deltas.",
      "lib": "",
      "name": "PositionAmounts",
      "fields": [
        {
          "doc": "",
          "name": "amount0",
          "type_": "u128"
        },
        {
          "doc": "",
          "name": "amount1",
          "type_": "u128"
        },
        {
          "doc": "",
          "name": "liquidity",
          "type_": "u128"
        },
        {
          "doc": "",
          "name": "updated_at",
          "type_": "u64"
        }
      ]
    }
  },
