    "function_v0": {
      "doc": "Permissionless TTL maintenance for named, already-existing intents\\nand their child execution records \\xe2\\x80\\x94 extending TTL creates no\\nauthority (\\xc2\\xa716.1), so no admin gate is needed. `Initialized`/`Admin`/\\n`Executor` live in instance storage (one shared TTL, refreshed\\nautomatically by `ensure_initialized` on every call that reaches\\nit), so no separate bump is needed for them here.",
      "name": "extend_intent_ttl",
      "inputs": [
        {
          "doc": "",
          "name": "intent_id",
          "type_": {
