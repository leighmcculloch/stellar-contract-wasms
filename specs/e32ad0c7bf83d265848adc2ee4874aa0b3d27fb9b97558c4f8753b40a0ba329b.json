  {
    "function_v0": {
      "doc": "Splits `token` from the treasury across `recipients[i]` receiving\\n`amounts[i]`, for every index. Positionally aligned by index;\\n`recipients` and `amounts` must have the same length, each amount\\nmust be positive, and the recipient count is bounded so a single\\ncall cannot be used to exhaust the transaction's resource budget or\\nsilently balloon the preauthorized action's blast radius.",
      "name": "execute_split",
      "inputs": [
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "recipients",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "amounts",
          "type_": {
            "vec": {
              "element_type": "i128"
            }
          }
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "void",
            "error_type": {
              "udt": {
                "name": "SplitAdapterError"
              }
            }
          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Security review finding: same gap as `transfer_adapter`'s identical\\nentrypoint -- this contract's instance TTL was only ever extended\\nas a side effect of `execute_split` succeeding, which itself\\nrequires the treasury's own authorization. A fully dormant\\ntreasury (no split payments at all for ~30 days -- plausible, e.g.\\na treasury that only ever does single-recipient transfers) had no\\npermissionless way to keep this adapter's instance storage alive.",
      "name": "extend_instance_ttl",
      "inputs": [],
      "outputs": []
    }
  }
