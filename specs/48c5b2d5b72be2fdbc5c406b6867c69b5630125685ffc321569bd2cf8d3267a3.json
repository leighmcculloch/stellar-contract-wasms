  {
    "function_v0": {
      "doc": "Runs inside the `CreateContract` host operation that deploys this\\ntoken, in the same transaction, so it is never observable on-ledger\\nin an uninitialized state. `admin` is the vault this token backs \\xe2\\x80\\x94\\nsee the module doc comment for why that's permanent, unlike the\\nvault's own admin.\\n\\nThis is the same fix blend-adapter's `__constructor` applies for\\n#505: `initialize()` below has no authorization check by design\\n(there is no admin in storage yet to check the caller against), so\\nif deploy and initialize were two separate transactions, anyone\\nwatching the ledger could land `initialize()` first with their own\\naddress as `admin`, permanently owning mint rights over this token.\\nRemoving the intervening ledger closes that window entirely, rather\\nthan trying to authorize a call that has no identity to authorize\\nagainst yet.",
      "name": "__constructor",
      "inputs": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "decimals",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "name",
          "type_": "string"
        },
        {
          "doc": "",
          "name": "symbol",
          "type_": "string"
        }
      ],
      "outputs": []
    }
  },
