          }
        }
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Sets the administrator, whose only power is the creation kill-switch. It\\ncan never touch escrow, block a settle, cancel a Swap, or upgrade the\\ncontract \\xe2\\x80\\x94 an open Swap stays settleable no matter what the admin does.\\n\\nRequiring the admin's own authorization stops an address being named\\nadministrator without its consent.",
      "name": "initialize",
      "inputs": [
        {
          "doc": "",
          "name": "admin",
          "type_": "address"
        }
      ],
      "outputs": []
    }
  },
  {
    "function_v0": {
      "doc": "Escrows `terms.sell_amount` and opens a Swap, returning its id.\\n\\nValidation runs before any transfer, and the escrow pull is bracketed by a\\nbalance read that panics on a short delta. A fee-skimming sell token is\\ntherefore not escrowable at all, which is the right outcome twice over:\\nthe taker's guarantee stays exact, and so does the pro-rata denominator\\nevery later fill divides by.\\n\\n`fee_amount` is Bitbond's service fee, charged once here and unrelated to\\n`terms.commission`, which is the maker's own brokerage on each settle. The\\nfee moves before the escrow so a failed fee cannot leave funds locked.",
      "name": "create_swap",
      "inputs": [
        {
          "doc": "",
          "name": "maker",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "terms",
          "type_": {
            "udt": {
              "name": "SwapTerms"
            }
          }
        },
        {
          "doc": "",
          "name": "fee_token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "fee_recipient",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "fee_amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        "u64"
      ]
    }
  },
