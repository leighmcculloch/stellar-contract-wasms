[
  {
    "function_v0": {
      "doc": "Returns the whole remaining escrow to the maker, on the maker's own\\nauthorization, at any time.",
      "name": "cancel",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": "u64"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Fills `take_amount` of the sell asset, returning what the taker paid.\\n\\nThe taker names the delivery, not the payment, because the delivery is the\\nescrowed quantity: it makes `remaining_sell` the single decrementing\\ncounter and drains escrow to exactly zero on a full fill, leaving no dust\\nsweep and no unclaimable sliver.\\n\\nState is written before any external call. The buy leg's delta is checked\\nbecause the maker cannot inspect it and cannot walk away once filled; the\\ncommission leg's is not, because a lying token costs only the recipient,\\nwhom the maker chose. A maker payout that nets to zero is skipped rather\\nthan refused \\xe2\\x80\\x94 panicking there would strand the very dust tail the\\n`min_fill` waiver exists to keep takeable.",
      "name": "settle",
      "inputs": [
        {
          "doc": "",
          "name": "taker",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "id",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "take_amount",
          "type_": "i128"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Returns an expired Swap's remaining escrow to the maker. Permissionless:\\nthe funds can only ever reach the maker, so triggering it grants a third\\nparty no power they did not already have, and it means an abandoned Swap\\ndoes not depend on its maker still being around.",
      "name": "reclaim",
      "inputs": [
        {
          "doc": "",
          "name": "id",
          "type_": "u64"
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
