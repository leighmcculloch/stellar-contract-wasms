  {
    "function_v0": {
      "doc": "ATOMIC MULTI-HOP: execute a whole path (up to MAX_PATH_HOPS swaps,\\nvenues mixed freely per hop) in ONE invocation. One signature; if\\nany hop disappoints, the entire path reverts and the user keeps\\nexactly what they started with. Funds never rest in a wallet\\nbetween hops, and each hop swaps the previous hop's ACTUAL output\\n(no conservative min-out chaining as with multi-transaction plans).\\n\\nThe protocol fee applies once, on the FINAL output, and\\n`min_final_out` protects the user net of it.\\n`estimated_out`: the GROSS final output the caller was quoted \\xe2\\x80\\x94\\nexecution above it splits the surplus per `get_surplus_share`\\n(0 disables capture for this call). Rejected below `min_final_out`\\nso a lowballed estimate can't reclassify honest output as surplus.",
      "name": "execute_path",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "total_amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "min_final_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "hops",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "PathHop"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "estimated_out",
          "type_": "i128"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": "i128",
            "error_type": {
              "udt": {
                "name": "RouterError"
              }
            }
          }
        }
      ]
    }
  },
