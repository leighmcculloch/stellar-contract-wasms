  {
    "function_v0": {
      "doc": "Swaps exactly `amount_in` of `token_in` for at least `min_out` of `token_out`\\nthrough `invocations`, run with this contract as caller. Returns the amount of\\n`token_out` delivered. Fee in `token_in` per \\xc2\\xa75.3. \\xc2\\xa75.4 lists the steps in order.",
      "name": "swap_exact_in",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "min_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "invocations",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Invocation"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "sweep",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "partner",
          "type_": {
            "option": {
              "value_type": {
                "udt": {
                  "name": "Partner"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
  {
    "function_v0": {
      "doc": "Buys at least `amount_out` of `token_out` (everything delivered is paid out) for at\\nmost `max_in` of `token_in`, fee included. The fee is taken on the input the legs\\nconsumed (\\xc2\\xa75.5). Returns the input spent, legs plus fee.",
      "name": "swap_exact_out",
      "inputs": [
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token_in",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "max_in",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "token_out",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount_out",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "invocations",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Invocation"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "sweep",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "partner",
          "type_": {
            "option": {
              "value_type": {
                "udt": {
                  "name": "Partner"
                }
              }
            }
          }
        }
      ],
      "outputs": [
        "i128"
      ]
    }
  },
