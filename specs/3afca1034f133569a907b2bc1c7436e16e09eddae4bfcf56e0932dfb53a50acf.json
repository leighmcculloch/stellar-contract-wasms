        {
          "doc": "Delivered less than `min_out` (exact-in) or `amount_out` (exact-out).",
          "name": "InsufficientOutput",
          "value": 7
        },
        {
          "doc": "Exact-out: the legs consumed no input, or the leftover input cannot cover the fee.",
          "name": "InsufficientInput",
          "value": 8
        },
        {
          "doc": "",
          "name": "NoPendingAdmin",
          "value": 9
        },
        {
          "doc": "A dial above `MAX_BPS`, or `min_partner_bps < protocol_bps`.",
          "name": "BpsOutOfRange",
          "value": 10
        },
        {
          "doc": "`Partner.id` is longer than 9 characters (not a `SymbolSmall`).",
          "name": "PartnerIdTooLong",
          "value": 11
        },
        {
          "doc": "Config missing. Unreachable after the constructor; kept so the read has no unwrap.",
          "name": "NotInitialized",
          "value": 12
        }
      ]
    }
