  {
    "function_v0": {
      "doc": "Deploys and wires a complete, ready-to-use treasury stack in one\\ncall. See the module doc comment for the authorization model and\\nwhat \"ready to use\" means (adapters already bound, no timelock;\\n`intent_registry` already initialized).\\n\\n`salt` only needs to be unique per `caller` \\xe2\\x80\\x94 sub-contract addresses\\nare derived from `sha256(caller || salt || per-contract tag)`, so one\\ncaller-chosen salt is enough to place all six deployments\\ndeterministically and collision-free against each other, and two\\ndifferent callers can safely choose the identical raw salt value\\nwith no cross-caller collision or squatting risk (see `sub_salt`'s\\ndoc comment for the security review finding this closed).\\n\\n`executor` is `intent_registry`'s scheduled-payment relayer address\\n(see `smart_account::initialize`'s doc comment on `initial_executor`\\nfor why this needs to be explicit rather than defaulted). Pass\\n`caller` again if there is no separate relayer identity yet.",
      "name": "deploy_account",
      "inputs": [
        {
          "doc": "",
          "name": "caller",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "salt",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "",
          "name": "initial_signers",
          "type_": {
            "vec": {
              "element_type": {
                "udt": {
                  "name": "Signer"
                }
              }
            }
          }
        },
        {
          "doc": "",
          "name": "initial_policies",
          "type_": {
            "map": {
              "key_type": "address",
              "value_type": "val"
            }
          }
        },
        {
          "doc": "",
          "name": "guardian_threshold",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "executor",
          "type_": "address"
        }
      ],
      "outputs": [
        {
          "result": {
            "ok_type": {
              "udt": {
                "name": "DeployedAccount"
              }
            },
            "error_type": {
              "udt": {
                "name": "AccountFactoryError"
              }
            }
          }
        }
      ]
    }
  },
