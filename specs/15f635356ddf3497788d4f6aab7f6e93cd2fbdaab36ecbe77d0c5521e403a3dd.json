  {
    "function_v0": {
      "doc": "Updates the WASM hashes used for every *future* `deploy_account`\\ncall. Admin-gated and deliberately mutable \\xe2\\x80\\x94 unlike `smart_account`'s\\nown pinned subordinate-module addresses (which protect one already\\n-deployed treasury's established trust), this only ever affects\\ntreasuries deployed *after* the update; already-deployed treasuries\\nare unaffected, since their addresses were already fixed at their\\nown deploy time. Shared infrastructure code getting patched over\\ntime is the ordinary case, not a residual risk to name.",
      "name": "set_wasm_hashes",
      "inputs": [
        {
          "doc": "",
          "name": "wasm_hashes",
          "type_": {
            "udt": {
              "name": "WasmHashes"
            }
          }
        }
      ],
