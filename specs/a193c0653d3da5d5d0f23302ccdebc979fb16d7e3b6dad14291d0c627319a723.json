  {
    "function_v0": {
      "doc": "Rotate the oracle's BLS public key, Stellar address, and Ed25519 signing key.\\n\\n# Authorization model\\nThe **current** oracle address must authorize this call. This prevents an\\nattacker who obtains a new keypair from hijacking the oracle role.\\n\\n# Security note\\nOnly rotate keys after the new oracle node is running and ready to fulfill\\nrequests. Any unfulfilled requests locked to the old PK will fail verification\\nafter rotation \\xe2\\x80\\x94 they must be refunded via `timeout_refund()`.",
      "name": "rotate_oracle_keys",
      "inputs": [
        {
          "doc": "",
          "name": "new_oracle_pk",
          "type_": {
            "bytes_n": {
              "n": 192
