  {
    "udt_struct_v0": {
      "doc": "The user signs this whole struct. Every field that could redirect or resize the transfer\\nis in here, so the signature pins all of them.",
      "lib": "",
      "name": "BridgeRequest",
      "fields": [
        {
          "doc": "Total the user is willing to spend, in 7-decimal stroops. Debited as `fee + net`;\\nthe sub-10-stroop remainder stays in the user's wallet.",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "Ledger at which the one-shot USDC allowance to Circle's TokenMessenger expires.\\n\\nSupplied by the caller rather than computed as `sequence() + N`, and that is not a\\nstylistic choice \\xe2\\x80\\x94 it is what makes the transaction signable at all. Soroban matches every\\nsub-invocation against the signed authorization tree **argument by argument**, and the\\nSAC's `approve(from, spender, amount, expiration_ledger)` requires the user's auth. A\\nvalue derived from `env.ledger().sequence()` is computed at *simulation* time when the\\ntree is built and again at *execution* time when it is checked \\xe2\\x80\\x94 and those are different\\nledgers, always. The two never match and every `bridge` fails with an authorization error.\\n\\nBounded at execution instead: not already past (the SAC rejects that outright), and no\\nfurther out than `APPROVAL_TTL_LEDGERS`, so nothing resembling a standing grant survives.",
          "name": "approval_expiration_ledger",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "deadline",
          "type_": "u64"
        },
        {
          "doc": "",
          "name": "destination_domain",
          "type_": "u32"
        },
        {
          "doc": "Circle's fee allowance, quoted off-chain from `get_min_fee_amount`. Bounded on-chain\\nby `check_max_fee`.",
          "name": "max_fee",
          "type_": "i128"
        },
        {
          "doc": "The user's own ceiling on *our* total fee, percentage and account fee together. Without\\nit, a `commit_params` landing in the same ledger could overcharge an already-signed\\nrequest.",
          "name": "max_wrapper_fee",
          "type_": "i128"
        },
        {
          "doc": "`<= 1000` requests Fast Transfer; `> 1000` is Standard.",
          "name": "min_finality_threshold",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "mint_recipient",
          "type_": {
            "bytes_n": {
              "n": 32
            }
          }
        },
        {
          "doc": "Whether the destination needs a token account created before it can receive the mint.\\n\\nDetermined off-chain \\xe2\\x80\\x94 it is a fact about Solana that a Stellar contract cannot see \\xe2\\x80\\x94 and\\nit only selects whether `params.account_fee` applies. A caller who sets this to `false`\\nwhen the account is in fact missing pays less and gets a mint that cannot land until\\nsomebody creates the account; the sponsor's rule is simply to not create an account it was\\nnot paid for. So the lie costs the liar, not us.",
          "name": "recipient_needs_account",
          "type_": "bool"
        },
        {
          "doc": "",
          "name": "user",
          "type_": "address"
        }
      ]
    }
  },
