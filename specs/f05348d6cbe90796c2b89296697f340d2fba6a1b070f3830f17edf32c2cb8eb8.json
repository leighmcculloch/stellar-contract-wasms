  {
    "function_v0": {
      "doc": "Permissionless TTL maintenance. `Initialized`/`Admin`/`Version` live\\nin instance storage (one shared TTL, refreshed automatically by\\n`ensure_initialized` on every call that reaches it \\xe2\\x80\\x94 see that\\nfunction) and are covered by the single `extend_ttl` call below;\\n`assets`/`recipients`/`operations` are named, already-existing\\nper-entity persistent entries, extended individually the same way\\nthey always were. Extending TTL does not create authority or alter\\nexecution semantics (`docs/TECHNICAL_ARCHITECTURE.md` \\xc2\\xa716.1), so\\nthis is intentionally open to any caller \\xe2\\x80\\x94 an off-chain monitor can\\nrefresh the entries it knows are still active without needing admin\\nkeys.",
      "name": "extend_ttl",
      "inputs": [
        {
          "doc": "",
          "name": "assets",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "recipients",
          "type_": {
            "vec": {
              "element_type": "address"
            }
          }
        },
        {
          "doc": "",
          "name": "operations",
          "type_": {
            "vec": {
              "element_type": "symbol"
            }
          }
        }
      ],
      "outputs": []
    }
